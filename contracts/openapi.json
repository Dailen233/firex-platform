      "Body_upload_capture_api_v1_runs__run_id__captures_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "metadata": {
            "type": "string",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "file",
          "metadata"
        ],
        "title": "Body_upload_capture_api_v1_runs__run_id__captures_post"
      },
      "CaptureRecord": {
