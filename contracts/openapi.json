            "type": "string",
            "title": "Content Sha256"
          },
          "byte_size": {
            "type": "integer",
            "title": "Byte Size"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "storage_key": {
            "type": "string",
            "title": "Storage Key"
          },
          "processing_started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Started At"
          },
          "processing_finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Finished At"
          },
          "processing_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Error"
          },
          "provider_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Version"
          }
        },
        "type": "object",
        "required": [
          "capture_id",
          "run_id",
          "received_at",
          "observation_time_s",
          "content_sha256",
          "byte_size",
          "status",
          "schema_version",
          "storage_key"
        ],
        "title": "CaptureRecord",
        "description": "A received capture and its processing status (queued/processing/completed/failed)."
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FirePatch": {
        "properties": {
          "patch_id": {
            "type": "string",
            "title": "Patch Id"
          },
          "geometry": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Geometry"
          }
        },
        "type": "object",
        "required": [
          "patch_id",
          "geometry"
        ],
        "title": "FirePatch",
        "description": "A fire polygon in minimal local XZ coordinates.\n\n``geometry`` is an ordered ring of ``[x, z]`` pairs that closes on itself\n(first vertex == last vertex). All values must be finite. This is the local\nsurface frame; world meaning comes from ``coordinate_frame_id``."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "algorithm_mode": {
            "type": "string",
            "title": "Algorithm Mode"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "firex-backend"
          },
          "processing_mode": {
            "type": "string",
            "title": "Processing Mode",
            "default": "unconfigured"
          }
        },
        "type": "object",
        "required": [
          "status",
          "algorithm_mode"
        ],
        "title": "HealthResponse"
      },
