setParameter[ForeFireDataDirectory=.]
setParameter[fuelsTableFile=fuels.csv]
setParameter[propagationModel=Rothermel]
setParameter[dumpMode=geojson]
setParameter[perimeterResolution=5]
setParameter[spatialIncrement=3]
setParameter[propagationSpeedAdjustmentFactor=0.6]
setParameter[windReductionFactor=0.4]

loadData[forefire_terrain.nc;2025-02-10T00:00:00Z]

startFire[loc=(5130,5130,0);t=0]

goTo[t=1800]
print[shuangjiangkou_1800s.geojson]

goTo[t=3600]
print[shuangjiangkou_3600s.geojson]

goTo[t=7200]
print[shuangjiangkou_7200s.geojson]

goTo[t=14400]
print[shuangjiangkou_14400s.geojson]

goTo[t=21600]
print[shuangjiangkou_21600s.geojson]

quit[]
